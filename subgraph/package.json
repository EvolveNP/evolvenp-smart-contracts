{
  "name": "evolvenp-subgraph",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:sepolia": "mustache networks/sepolia.json subgraph.template.yaml > subgraph.yaml",
    "codegen": "npm run prepare:sepolia && graph codegen",
    "build:sepolia": "npm run prepare:sepolia && graph build",
    "deploy:sepolia": "npm run prepare:sepolia && graph deploy evolve-np-smart-contracts --deploy-key ${DEPLOY_KEY}",
    "build": "graph build",
    "deploy": "graph deploy evolve-np-smart-contracts --deploy-key ${DEPLOY_KEY}"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.97.1",
    "@graphprotocol/graph-ts": "^0.35.1",
    "mustache": "^4.2.0"
  }
}
